# Example environment variables for the automation project.
# Do **not** commit your real API tokens to version control.

# Notion integration secret for the Notion API (e.g. "secret_XXXXXXXXXXXX").
NOTION_TOKEN=your_notion_integration_token

# The ID of the Notion database where records should be created.
NOTION_DATABASE_ID=your_notion_database_id

# Telegram bot token provided by BotFather. This should start with "123456:"
TELEGRAM_TOKEN=your_telegram_bot_token

# Telegram chat ID where notifications will be sent (e.g. "-1001234567890").
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Optional: free‑form title for the Notion page created by this script.
NOTION_PAGE_TITLE=Automated Log Entry
